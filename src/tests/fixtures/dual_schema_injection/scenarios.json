  "integration": [
    {
      "id": "live_t2_optional_only_hint",
      "query": "dual optional verbose boolean doctor",
      "tool_tiers": {
        "cyt_mcp:dual_tool_optional_only": "ACTIVE",
        "cyt_mcp:dual_tool_empty": "DORMANT",
        "cyt_mcp:dual_tool_purge": "DORMANT"
      },
      "must_include_tools": ["dual_tool_optional_only"],
      "expected_stamped_tiers": {
        "dual_tool_optional_only": "t2"
      },
      "expected_has_backend_schema": ["dual_tool_optional_only"],
      "expected_injection": {
        "dual_tool_optional_only": {
          "hint": true
        }
      }
    },
    {
      "id": "live_t3_empty_explicit_schema",
      "query": "dual parameterless empty schema",
      "tool_tiers": {
        "cyt_mcp:dual_tool_empty": "HOT",
        "cyt_mcp:dual_tool_optional_only": "DORMANT",
        "cyt_mcp:dual_tool_purge": "DORMANT"
      },
      "must_include_tools": ["dual_tool_empty"],
      "expected_stamped_tiers": {
        "dual_tool_empty": "t3"
      },
      "expected_has_backend_schema": ["dual_tool_empty"],
      "expected_injection": {
        "dual_tool_empty": {
          "explicit_empty_schema": true
        }
      }
    },
    {
      "id": "live_t2_required_merge",
      "query": "dual purge confirm destructive scope",
      "tool_tiers": {
        "cyt_mcp:dual_tool_purge": "ACTIVE",
        "cyt_mcp:dual_tool_optional_only": "DORMANT",
        "cyt_mcp:dual_tool_empty": "DORMANT"
      },
      "must_include_tools": ["dual_tool_purge"],
      "expected_stamped_tiers": {
        "dual_tool_purge": "t2"
      },
      "expected_has_backend_schema": ["dual_tool_purge"],
      "expected_injection": {
        "dual_tool_purge": {
          "required_keys": ["confirm"]
        }
      }
    },
    {
      "id": "live_t4_direct_preserves_backend",
      "query": "dual required optional query limit",
      "tool_tiers": {
        "cyt_mcp:dual_tool_required_optional": "EXTRA_HOT",
        "cyt_mcp:dual_tool_empty": "DORMANT",
        "cyt_mcp:dual_tool_optional_only": "DORMANT",
        "cyt_mcp:dual_tool_purge": "DORMANT",
        "cyt_mcp:dual_tool_required_only": "DORMANT"
      },
      "must_include_tools": ["dual_tool_required_optional"],
      "expected_stamped_tiers": {
        "dual_tool_required_optional": "t4"
      },
      "expected_has_backend_schema": ["dual_tool_required_optional"],
      "expected_injection": {
        "dual_tool_required_optional": {
          "required_keys": ["query"],
          "optional_keys": ["limit"]
        }
      }
    }
  ]
}
