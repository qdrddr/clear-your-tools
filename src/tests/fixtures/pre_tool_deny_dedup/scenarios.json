{
  "scenarios": [
    {
      "id": "first_schema_deny_includes_definition",
      "session_log": "type2_filesystem_read_file",
      "tool": "filesystem_read_file",
      "tool_input": {"bogus": "x"},
      "expect": {
        "allowed": false,
        "includes_definition": true,
        "includes_reason": true,
        "reason_contains": ["invalid cyt-mcp tool arguments", "unknown property"]
      }
    },
    {
      "id": "pre_exposed_type1_omits_definition",
      "session_log": "type2_with_type1_deny_entry",
      "tool": "filesystem_read_file",
      "tool_input": {"bogus": "x"},
      "expect": {
        "allowed": false,
        "includes_definition": false,
        "includes_reason": true
      }
    },
    {
      "id": "post_compaction_reincludes_definition",
      "session_log": "post_compaction_fresh_window",
      "tool": "filesystem_read_file",
      "tool_input": {"bogus": "x"},
      "expect": {
        "allowed": false,
        "includes_definition": true,
        "includes_reason": true
      }
    },
    {
      "id": "unknown_tool_still_shows_get_tool_definitions_hint",
      "session_log": "type2_filesystem_read_file",
      "tool": "filesystem_write_file",
      "tool_input": {"path": "/tmp/x"},
      "expect": {
        "allowed": false,
        "includes_definition": false,
        "includes_reason": true,
        "reason_contains": ["get-tool-definitions", "Available tools:"]
      }
    },
    {
      "id": "prior_deny_json_in_prompt_omits_definition",
      "session_log": "type2_filesystem_read_file",
      "tool": "filesystem_read_file",
      "tool_input": {"bogus": "x"},
      "prompt": "Correct tool definition: {\"name\":\"filesystem_read_file\",\"input_schema\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"}},\"required\":[\"path\"]}}",
      "expect": {
        "allowed": false,
        "includes_definition": false,
        "includes_reason": true
      }
    },
    {
      "id": "mcpc_first_schema_deny_includes_definition",
      "session_log": "type2_mcpc_demo_run",
      "tool": "Shell",
      "shell_command": "echo '{\"bad\":1}' | mcpc @agent-session tools-call demo_mcpc_run",
      "expect": {
        "allowed": false,
        "includes_definition": true,
        "includes_reason": true,
        "reason_contains": ["Invalid mcpc Shell arguments"]
      }
    },
    {
      "id": "definitions_first_schema_deny_includes_definition",
      "session_log": "type2_definitions_demo_lookup",
      "tool": "demo_definitions_lookup",
      "tool_input": {"wrong": "field"},
      "expect": {
        "allowed": false,
        "includes_definition": true,
        "includes_reason": true,
        "reason_contains": ["Invalid definitions tool arguments"]
      }
    }
  ],
  "integration_scenarios": [
    {
      "id": "handle_then_validate_omits_second_definition",
      "session_log": "type2_filesystem_read_file",
      "tool": "filesystem_read_file",
      "tool_input": {"bogus": "x"},
      "steps": [
        {"action": "handle_pre_tool", "expect": {"includes_definition": true}},
        {"action": "validate", "expect": {"includes_definition": false, "includes_reason": true}}
      ],
      "expect_persist": {
        "post_compaction_deny_entries": 1,
        "tool_name": "filesystem_read_file"
      }
    },
    {
      "id": "post_compaction_handle_persists_once",
      "session_log": "post_compaction_fresh_window",
      "tool": "filesystem_read_file",
      "tool_input": {"bogus": "x"},
      "steps": [
        {"action": "validate", "expect": {"includes_definition": true}},
        {"action": "handle_pre_tool", "expect": {"includes_definition": true}}
      ],
      "expect_persist": {
        "post_compaction_deny_entries": 1,
        "tool_name": "filesystem_read_file"
      }
    },
    {
      "id": "double_handle_same_window_single_persist",
      "session_log": "type2_filesystem_read_file",
      "tool": "filesystem_read_file",
      "tool_input": {"bogus": "x"},
      "steps": [
        {"action": "handle_pre_tool", "expect": {"includes_definition": true}},
        {"action": "handle_pre_tool", "expect": {"includes_definition": false, "includes_reason": true}}
      ],
      "expect_persist": {
        "post_compaction_deny_entries": 1,
        "tool_name": "filesystem_read_file"
      }
    }
  ]
}
