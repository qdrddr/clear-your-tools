    "input_schema": {
      "type": "object",
      "properties": {
        "queries": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "required": ["queries"]
    }
  },
  "config": {
    "capture_default": "cyt_mcp",
    "capture_hooks": "hooks"
