    "context-mode_ctx_search"
  ],
  "scenarios": [
    {
      "id": "workspace_disable_hedl_batch_via_slash_agent_alias",
      "agent": "cursor",
      "agent_target": "all",
      "steps": [
        {"action": "disable", "scope": "workspace", "kind": "mcp_tool", "target": "hedl/hedl_batch"}
      ],
      "expected": {
        "enabled_tools": ["hedl_hedl_read", "hedl_hedl_write", "context-mode_ctx_search"],
        "disabled_tools": ["hedl_batch"]
      }
    },
    {
