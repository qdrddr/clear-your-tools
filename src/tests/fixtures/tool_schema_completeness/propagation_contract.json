  "pipeline_scenarios": [
    {
      "id": "unpruned_type2_contains_tool_not_in_pruned_output",
      "description": "Type-2 master catalog includes tools dropped from pruned injection",
      "master_catalog_source": "bm25_subset",
      "prune_query": "Use fff_grep to search BM25 pattern in repository files only",
      "type2_tool_ref": "fff_grep",
      "pruned_must_include": ["fff_grep"],
      "pruned_must_exclude": ["gitnexus_cypher", "semble_search"],
      "type2_must_include": ["fff_grep", "gitnexus_cypher", "semble_search"]
    },
    {
      "id": "survived_t2_type1_and_injection_have_all_required",
      "description": "Survived T2 tool keeps all backend required in Type-1 and injection",
      "master_catalog_source": "full_ws_disk",
      "prune_query": "Locate primary code implementing BM25, use MCP: semble_search gitnexus_cypher",
      "tool_ref": "semble_search",
      "tier": "t2",
      "expected_required": ["query", "repo"]
    },
    {
      "id": "survived_t3_injection_includes_optionals_t2_does_not",
      "description": "T3 injection includes optionals; T2 does not",
      "master_catalog_source": "dual_schema",
      "prune_query": "search symbols with optional limit parameter",
      "tool_ref": "dual_tool_required_optional",
      "tier_t2_optional_forbidden": ["limit"],
      "tier_t3_optional_required": ["limit"]
    },
    {
      "id": "cross_tool_no_query_on_gitnexus",
      "description": "semble query required must not appear on gitnexus_cypher injection",
      "master_catalog_source": "full_ws_disk",
      "prune_query": "Run gitnexus_cypher to query the knowledge graph for BM25",
      "owner_tool_ref": "semble_search",
      "leaked_property": "query",
      "target_tool_ref": "gitnexus_cypher"
    },
    {
      "id": "degraded_partial_registry_without_disk",
      "description": "Partial registry without disk keeps partial required (documented exception)",
      "master_catalog_source": "partial_ws_registry",
      "tool_ref": "semble_search",
      "expected_required": ["query"],
      "forbidden_properties": ["repo"]
    },
    {
      "id": "backend_identity_preserved_in_type2",
      "description": "Type-2 records preserve server_key and tool_name mapping",
      "master_catalog_source": "full_ws_disk",
      "tool_ref": "semble_search",
      "server_key": "semble",
      "tool_name": "search"
    },
    {
      "id": "backend_identity_preserved_in_type1",
      "description": "Type-1 records preserve server_key and tool_name mapping",
      "master_catalog_source": "full_ws_disk",
      "tool_ref": "semble_search",
      "server_key": "semble",
      "tool_name": "search"
    }
  ],
  "session_log_identity": {
