{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "CYT_LAUNCH_AGENT=cursor cyt hook daemon start --unattended",
        "timeout": 60
      },
      {
        "command": "CYT_LAUNCH_AGENT=cursor cyt-client",
        "timeout": 60
      }
    ],
    "sessionEnd": [
      {
        "command": "CYT_LAUNCH_AGENT=cursor cyt-client",
        "timeout": 60
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "CYT_LAUNCH_AGENT=cursor cyt-client",
        "timeout": 60
      }
    ],
    "preToolUse": [
      {
        "command": "CYT_LAUNCH_AGENT=cursor cyt-client",
        "timeout": 60
      }
    ],
    "postToolUse": [
      {
        "command": "CYT_LAUNCH_AGENT=cursor cyt-client",
        "matcher": "search|cyt-mcp_search|MCP:search|MCP:cyt-mcp_search|mcp__cyt-mcp__search",
        "timeout": 60
      }
    ]
  }
}
