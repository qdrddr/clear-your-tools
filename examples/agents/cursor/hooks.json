{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "CYT_LAUNCH_AGENT=cursor cyt hook daemon start --unattended",
        "timeout": 60
      },
      {
        "command": "CYT_LAUNCH_AGENT=cursor cyt-client",
        "timeout": 60
      }
    ],
    "sessionEnd": [
      {
        "command": "CYT_LAUNCH_AGENT=cursor cyt-client",
        "timeout": 60
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "CYT_LAUNCH_AGENT=cursor cyt-client",
        "timeout": 60
      }
    ],
    "preToolUse": [
      {
        "command": "CYT_LAUNCH_AGENT=cursor cyt-client",
        "timeout": 60
      }
    ],
    "postToolUse": [
      {
        "command": "CYT_LAUNCH_AGENT=cursor cyt-client",
        "matcher": "get-tool-definitions|cyt-mcp_get-tool-definitions|MCP:get-tool-definitions|MCP:cyt-mcp_get-tool-definitions|mcp__cyt-mcp__get-tool-definitions",
        "timeout": 60
      }
    ]
  }
}
