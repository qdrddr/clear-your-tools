{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CYT_LAUNCH_AGENT=claude cyt hook daemon start --unattended",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CYT_LAUNCH_AGENT=claude cyt-client",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CYT_LAUNCH_AGENT=claude cyt-client",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
